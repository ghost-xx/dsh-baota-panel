{
  "name": "dsh-baota-panel",
  "version": "0.9.0",
  "type": "module",
  "description": "Baota (bt.cn) Linux panel tools and a sidebar panel for DSH Web: one API key manages sites, databases, files, cron, logs and services.",
  "license": "MIT",
  "author": "ghost-xx",
  "homepage": "https://github.com/ghost-xx/dsh-baota-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghost-xx/dsh-baota-panel.git"
  },
  "bugs": {
    "url": "https://github.com/ghost-xx/dsh-baota-panel/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "bundle",
    "baota",
    "bt.cn",
    "panel",
    "ops"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  }
}
